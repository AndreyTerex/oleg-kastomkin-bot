# Скопируйте этот файл в .env и заполните значения. Файл .env в git не попадает.

# Токен бота: Developer Portal -> Applications -> ваш бот -> Bot -> Reset Token
DISCORD_TOKEN=

# ID сервера. Если указан, слэш-команды появляются мгновенно,
# иначе Discord раскатывает их глобально до часа.
GUILD_ID=

# ID ролей линий. Значения по умолчанию уже прописаны в config.py,
# здесь их можно переопределить, не трогая код.
ROLE_ID_TOP=
ROLE_ID_JUNGLE=
ROLE_ID_MID=
ROLE_ID_ADC=
ROLE_ID_SUPPORT=

# Каталог для сохранения сборов внутри контейнера.
DATA_DIR=data

# ID канала для тревог (только для админов): ошибки, VPN лежит, все нейросети на лимите.
# ПКМ по каналу -> Копировать ID канала (нужен режим разработчика). Пусто — тревоги не шлются.
ALERT_CHANNEL_ID=
# Канал для итогов недели и приглашений на кастомку. Пусто — канал, где отмечали последнюю катку.
ANNOUNCE_CHANNEL_ID=
# Итоги недели: день (0 — пн … 5 — сб) и час; RECAP_HOUR=-1 — не публиковать
# RECAP_WEEKDAY=5
# RECAP_HOUR=11
# С какого часа Олег зовёт на кастомку, если сегодня сбора нет (-1 — не звать)
# LOBBY_INVITE_HOUR=17
# Викторина: канал (пусто — канал объявлений), раз во сколько минут (0 — только /quiz), часы, награда
# QUIZ_CHANNEL_ID=
# QUIZ_MINUTES=45
# QUIZ_HOURS=12-24
# QUIZ_COINS=50
# Патчноуты после обновлений (0 — не писать)
# PATCH_NOTES=1
# Fearless-драфт (чемпионы прошлых каток серии не выпадают): 1 — да (по умолчанию), 0 — нет
# FEARLESS_DRAFT=1
# Сколько минут после раздачи принимаются ставки
# BET_MINUTES=10
# Сколько минут голосуют за MVP после катки (0 — не голосовать, максимум 14)
# MVP_VOTE_MINUTES=10
# Синхронизация данных между компьютерами: ID закрытого канала (только админы и бот). Пусто — выключена.
SYNC_CHANNEL_ID=
# SYNC_MINUTES=5
# SYNC_LOCK_STALE=180
# Сколько ежедневных копий data/ хранить в data/backups (по умолчанию 7)
# BACKUP_KEEP=7
# Перезапуск, если нет связи с Discord столько минут (0 — не следить)
# WATCHDOG_DISCONNECT_MINUTES=15

# Ключ Google AI Studio (aistudio.google.com -> Get API key) — Gemini Flash, основная модель Олега. Можно оставить пустым.
GEMINI_API_KEY=

# Google не пускает к Gemini из России. VPN для Gemini — ссылка на подписку из вашего VPN-сервиса
# (VLESS/Trojan/VMess/Shadowsocks/Hysteria2; base64, список ключей или JSON). Бот сам запустит Xray, проверит все
# серверы и будет ходить через быстрый рабочий с выходом не в России — ко всем нейросетям (Discord — напрямую).
# Вместо подписки можно вставить один или несколько ключей через запятую: VPN_URL=vless://...
VPN_SUBSCRIPTION=
# Всё ниже необязательно — значения по умолчанию подходят (подробнее в README, раздел «VPN для Gemini»).
# Брать только серверы с такими словами в названии, например DE|NL|Finland
# VPN_FILTER=
# Страны ВЫХОДА, которые не подходят (определяются по факту, а не по названию сервера)
# VPN_EXCLUDE_COUNTRIES=RU,BY,CN,HK,MO,IR,KP,CU,SY
# Фрагментация TLS против блокировок провайдера: auto | on | off
# VPN_FRAGMENT=auto
# Как часто проверять текущий сервер (минуты) и все серверы (часы)
# VPN_RECHECK_MINUTES=12
# VPN_FULL_CHECK_HOURS=3
# Насколько новый сервер должен быть быстрее, чтобы переключиться (0.3 = на 30%)
# VPN_SWITCH_THRESHOLD=0.3
# Какие нейросети через VPN (all или gemini,groq,...) и пускать ли через VPN Discord (1 — да, 0 — напрямую)
# LLM_PROXY_FOR=all
# VPN_FOR_DISCORD=0
# Сколько серверов проверять одновременно и сколько секунд ждать ответа
# VPN_PROBE_CONCURRENCY=8
# VPN_PROBE_TIMEOUT=8
# Или готовый HTTP-прокси вместо VPN:
# LLM_PROXY=http://логин:пароль@адрес:порт

# Gemini часто «перегружен» (HTTP 503): сколько раз переспросить модель с большим лимитом (Flash Lite, Groq)
# перед следующей. Gemini Flash (20 запросов в день) не переспрашивается — сразу следующая модель.
# LLM_OVERLOAD_RETRIES=3

# Бесплатный ключ Groq (console.groq.com) — чтобы Олег болтал в чате. Можно оставить пустым.
GROQ_API_KEY=

# Бесплатный ключ OpenRouter (openrouter.ai) — модели поумнее, около 50 ответов в день. Можно оставить пустым.
OPENROUTER_API_KEY=

# Токен Hugging Face с правом «Make calls to Inference Providers» — около 170 ответов в месяц бесплатно. Можно оставить пустым.
HF_TOKEN=

# Токен Puter (puter.com → Settings → токен, см. developer.puter.com/tutorials/puter-auth-token/) — Grok и другие
# сильные модели. Платит владелец токена: сначала бесплатная месячная квота, потом бот сам пропускает Puter.
PUTER_AUTH_TOKEN=
# Необязательно: модели Puter по порядку
# PUTER_MODELS=x-ai/grok-4.1-fast,x-ai/grok-4.6,gpt-5.4-nano

# Ключ Z.ai (z.ai → регистрация по почте → профиль → API Keys) — бесплатные GLM Flash. Можно оставить пустым.
ZAI_API_KEY=

# Ключ TokenHarbor (tokenharbor.ai, почта должна быть подтверждена) — бесплатные модели :free с недельным лимитом. Можно оставить пустым.
TOKENHARBOR_API_KEY=

# Часовой пояс, в котором пишется время сбора («сегодня 21:00»). Игроки видят время в своём поясе.
TIMEZONE=Europe/Moscow

# За сколько минут до начала сбора бот тегает записавшихся. 0 — не напоминать.
REMIND_MINUTES=15

# Автообновление (Watchtower). Нужно, только если образ бота на GitHub приватный:
# логин GitHub и токен (Settings -> Developer settings -> Personal access tokens -> classic, право read:packages).
GHCR_USER=
GHCR_TOKEN=

# Какие провайдеры нейросети отвечают первыми (через запятую). По умолчанию сначала Gemini, потом Groq,
# остальные в запасе.
# LLM_ORDER=gemini,groq,tokenharbor,openrouter,huggingface
