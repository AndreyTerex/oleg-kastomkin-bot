# Скопируйте этот файл в .env и заполните значения. Файл .env в git не попадает.

# Токен бота: Developer Portal -> Applications -> ваш бот -> Bot -> Reset Token
DISCORD_TOKEN=

# ID сервера. Если указан, слэш-команды появляются мгновенно,
# иначе Discord раскатывает их глобально до часа.
GUILD_ID=

# ID ролей линий. Значения по умолчанию уже прописаны в config.py,
# здесь их можно переопределить, не трогая код.
ROLE_ID_TOP=
ROLE_ID_JUNGLE=
ROLE_ID_MID=
ROLE_ID_ADC=
ROLE_ID_SUPPORT=

# Каталог для сохранения сборов внутри контейнера.
DATA_DIR=data

# Бесплатный ключ Groq (console.groq.com) — чтобы Олег болтал в чате. Можно оставить пустым.
GROQ_API_KEY=

# Бесплатный ключ OpenRouter (openrouter.ai) — модели поумнее, около 50 ответов в день. Можно оставить пустым.
OPENROUTER_API_KEY=

# Токен Hugging Face с правом «Make calls to Inference Providers» — около 170 ответов в месяц бесплатно. Можно оставить пустым.
HF_TOKEN=

# Ключ TokenHarbor (tokenharbor.ai, почта должна быть подтверждена) — бесплатные модели :free с недельным лимитом. Можно оставить пустым.
TOKENHARBOR_API_KEY=

# Часовой пояс, в котором пишется время сбора («сегодня 21:00»). Игроки видят время в своём поясе.
TIMEZONE=Europe/Moscow

# За сколько минут до начала сбора бот тегает записавшихся. 0 — не напоминать.
REMIND_MINUTES=15

# Автообновление (Watchtower). Нужно, только если образ бота на GitHub приватный:
# логин GitHub и токен (Settings -> Developer settings -> Personal access tokens -> classic, право read:packages).
GHCR_USER=
GHCR_TOKEN=

# Какие провайдеры нейросети отвечают первыми (через запятую). По умолчанию сначала Groq —
# у него самый большой бесплатный лимит, — остальные в запасе.
# LLM_ORDER=groq,tokenharbor,openrouter,huggingface
